# Variables de entorno — Impels Commerce
# Copiar este archivo como .env.local y completar con valores reales.
# NUNCA commitear .env.local al repositorio.

# ── Supabase ─────────────────────────────────────────────────────
# Obtener en: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ──────────────────────────────────────────────────────────
# URL base de la aplicación (sin slash final)
# Desarrollo: http://localhost:3000
# Producción: https://impels.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Super Admin ──────────────────────────────────────────────────
# Emails con acceso a /admin, separados por coma (sin espacios)
# Estos usuarios además pueden tener is_super_admin=true en user_metadata de Supabase Auth
SUPER_ADMIN_EMAILS=admin@tudominio.com
